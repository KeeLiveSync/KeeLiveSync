<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>KeeLiveSync</AssemblyName>
    <RootNamespace>KeeLiveSync</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- KeePass liest Titel, Beschreibung, Firma und Version für die Plugin-Liste -->
    <AssemblyTitle>KeeLiveSync</AssemblyTitle>
    <Product>KeePass Plugin</Product>
    <Description>Live synchronization of KeePass databases, works with Microsoft OneDrive</Description>
    <Company>Michael Kaufmann</Company>
    <Copyright>Copyright © 2026 Michael Kaufmann</Copyright>
    <Version>0.4.1</Version>
    <RepositoryUrl>https://github.com/KeeLiveSync/KeeLiveSync</RepositoryUrl>
    <!-- Ordner mit KeePass.exe; Standard: Test-KeePass, sonst per -p:KeePassDir=... angeben -->
    <KeePassDir Condition="'$(KeePassDir)' == ''">$(USERPROFILE)\KeeLiveSyncDEV</KeePassDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassDir)\KeePass.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sprachdateien in der DLL; Name: KeeLiveSync.Languages.<iso>.json -->
    <EmbeddedResource Include="Languages\*.json" LogicalName="KeeLiveSync.Languages.%(Filename).json" />
  </ItemGroup>

  <Target Name="CopyToTestKeePass" AfterTargets="Build" Condition="Exists('$(KeePassDir)\Plugins')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(KeePassDir)\Plugins" />
  </Target>

</Project>
